<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="MainController">
   <top>
      <VBox alignment="CENTER" prefHeight="110.0" prefWidth="800.0" spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <TextField fx:id="txtPesquisa" prefHeight="35.0" prefWidth="300.0" promptText="Pesquisar por pokémon..." />
                  <Button fx:id="btnPesquisar" mnemonicParsing="false" prefHeight="35.0" prefWidth="90.0" text="Pesquisar" />
               </children>
            </HBox>
            <Button fx:id="btnInspecionarTime" mnemonicParsing="false" prefHeight="35.0" prefWidth="150.0" text="Inspecionar Time" />
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </top>
   <center>
      <ScrollPane fitToWidth="true" prefHeight="200.0" prefWidth="200.0" style="-fx-background-color: transparent;" BorderPane.alignment="CENTER">
         <content>
            <TilePane fx:id="containerCards" hgap="20.0" prefTileHeight="180.0" prefTileWidth="150.0" vgap="20.0">
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
            </TilePane>
         </content>
      </ScrollPane>
   </center>
</BorderPane>
